  "risks": [
    {
      "node": 3,
      "score": 9.8,
      "level": "critical",
      "explanation": "The File Server runs an old Samba version with a very serious flaw (CVE-2017-7494). Every attack path goes through this machine, so if it falls, the attacker can reach both the database and the domain controller."
    },
    {
      "node": 6,
      "score": 9.4,
      "level": "critical",
      "explanation": "The Domain Controller controls all logins in the company. It has the Zerologon flaw (CVE-2020-1472), and an attacker can also get here with a stolen shared login from the Admin Workstation."
    },
    {
      "node": 1,
      "score": 7.5,
      "level": "high",
      "explanation": "The Public Website is open to the internet and runs Apache 2.4.49, which has a known file-reading flaw (CVE-2021-41773). It is an easy first step for an attacker."
    },
    {
      "node": 4,
      "score": 7.2,
      "level": "high",
      "explanation": "The Customer Database holds sensitive data. Its own flaw is small (CVE-2020-14812), but the File Server can talk to it directly, so a hacked File Server puts it at risk."
    },
    {
      "node": 5,
      "score": 5.5,
      "level": "medium",
      "explanation": "The Admin Workstation has no known flaws, but it shares logins with the File Server and the Domain Controller. It acts as a bridge the attacker can walk across."
    },
    {
      "node": 2,
      "score": 4.6,
      "level": "medium",
      "explanation": "The Employee Laptop runs Office 2016 with a known flaw (CVE-2017-11882). A bad document could give an attacker a starting point inside the network."
    }
  ],
  "fixes": [
    {
      "node": 3,
      "fix": "Update Samba to a patched version, and block port 445 from the Public Website and from laptops."
    },
    {
      "node": 6,
      "fix": "Install the August 2020 Windows security updates that fix Zerologon, and limit who can log in to the Domain Controller."
    },
    {
      "node": 1,
      "fix": "Upgrade Apache to 2.4.51 or newer, and put the website in a separate network zone (DMZ)."
    },
    {
      "node": 4,
      "fix": "Update MySQL, and allow database connections only from the application servers that need them."
    },
    {
      "node": 5,
      "fix": "Stop reusing the same login across machines. Give the admin account a unique password and turn on multi-factor login."
    },
    {
      "node": 2,
      "fix": "Update Microsoft Office, and block documents from unknown senders from opening macros or embedded objects."
    }
  ]
